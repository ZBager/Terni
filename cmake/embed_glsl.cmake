# Generates a C++ source holding the Terni GLSL library (shaders/terni/*.glsl), so
# hosts don't have to ship or locate those files at runtime.
#   cmake -DDIR=<shaders dir> -DOUT=<generated .cpp> -P embed_glsl.cmake
file(GLOB files RELATIVE ${DIR} ${DIR}/terni/*.glsl)
list(SORT files)
set(body "")
# MSVC limits one string literal piece to about 16 KB and a whole literal to 64 KB, so
# each file becomes adjacent raw literals of at most 8 KB, split after a newline.
set(piece_max 8192)
set(file_max 60000)
foreach(f ${files})
  file(READ ${DIR}/${f} content)
  string(REPLACE "\r\n" "\n" content "${content}")  # the same bytes whatever Git did to line endings
  string(LENGTH "${content}" size)
  if(size GREATER file_max)
    message(FATAL_ERROR "${f} is ${size} bytes; embedded GLSL files must stay under ${file_max} (split the file)")
  endif()
  string(APPEND body "    {\"${f}\",\n")
  while(size GREATER piece_max)
    string(SUBSTRING "${content}" 0 ${piece_max} head)
    string(FIND "${head}" "\n" cut REVERSE)
    if(cut LESS 0)
      message(FATAL_ERROR "${f}: a line longer than ${piece_max} bytes")
    endif()
    math(EXPR cut "${cut} + 1")
    string(SUBSTRING "${content}" 0 ${cut} head)
    string(SUBSTRING "${content}" ${cut} -1 content)
    string(APPEND body "     R\"TERNI_GLSL(${head})TERNI_GLSL\"\n")
    string(LENGTH "${content}" size)
  endwhile()
  string(APPEND body "     R\"TERNI_GLSL(${content})TERNI_GLSL\"},\n")
endforeach()
list(LENGTH files count)
file(WRITE ${OUT}.tmp
"// Generated by cmake/embed_glsl.cmake from shaders/terni/*.glsl -- do not edit.
#include \"embedded_glsl.hpp\"

namespace terni::detail {
const EmbeddedFile kEmbeddedGlsl[] = {
${body}};
const size_t kEmbeddedGlslCount = ${count};
}  // namespace terni::detail
")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUT}.tmp)
