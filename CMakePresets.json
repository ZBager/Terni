{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux",
      "displayName": "Linux (GCC or Clang)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows, Visual Studio 2022 or 2026 (MSVC)",
      "description": "Run from a Developer PowerShell or Developer Command Prompt for VS, or open the folder in Visual Studio",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl" },
      "architecture": { "value": "x64", "strategy": "external" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows, MinGW-w64 (MSYS2 UCRT64)",
      "description": "Run from an MSYS2 UCRT64 shell",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux" },
    { "name": "windows-msvc", "configurePreset": "windows-msvc" },
    { "name": "windows-mingw", "configurePreset": "windows-mingw" }
  ],
  "testPresets": [
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "output": { "outputOnFailure": true } },
    { "name": "windows-mingw", "configurePreset": "windows-mingw", "output": { "outputOnFailure": true } }
  ]
}
