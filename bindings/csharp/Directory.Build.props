<Project>
  <!-- Build output goes outside the source tree when TERNI_DOTNET_ARTIFACTS is set (ctest
       sets it to the build folder), else into artifacts/ here (ignored by git). -->
  <PropertyGroup>
    <ArtifactsPath Condition="'$(TERNI_DOTNET_ARTIFACTS)' != ''">$(TERNI_DOTNET_ARTIFACTS)</ArtifactsPath>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>
</Project>
