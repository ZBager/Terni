#version 460
#extension GL_GOOGLE_include_directive : require
#include "terni/compute.glsl"
#include "terni/wide.glsl"

// 64/128-bit helpers of terni/wide.glsl applied to random and edge-case operands.
layout(std430, binding = 0) readonly buffer ParamsBuf { uint n; };
layout(std430, binding = 1) readonly buffer ABuf { uvec2 in_a[]; };
layout(std430, binding = 2) readonly buffer BBuf { uvec2 in_b[]; };
layout(std430, binding = 3) readonly buffer CBuf { uvec2 in_c[]; };
layout(std430, binding = 4) readonly buffer RBuf { int in_r[]; };
layout(std430, binding = 5) buffer OutBuf { uint outputs[]; };  // 15 per item

void main() {
    FOR_EACH(i, n) {
        const uvec2 a = in_a[i], b = in_b[i], c = in_c[i];
        const uint o = i * 15u;
        const uvec2 m = mul_i64_q16(a, in_r[i]);
        const uvec4 p = mul_i64_i64(a, b);
        const uvec2 md = muldiv_i64(a, b, c);
        const uvec2 dq = div_q16_i64(a, c);
        const uvec2 s = sub_i64(a, b);
        outputs[o + 0u] = m.x; outputs[o + 1u] = m.y;
        for (uint k = 0u; k < 4u; ++k) outputs[o + 2u + k] = p[k];
        outputs[o + 6u] = md.x; outputs[o + 7u] = md.y;
        outputs[o + 8u] = dq.x; outputs[o + 9u] = dq.y;
        outputs[o + 10u] = s.x; outputs[o + 11u] = s.y;
        outputs[o + 12u] = lt_i64(a, b) ? 1u : 0u;
        const uvec2 mx = max_i64(a, c);
        outputs[o + 13u] = mx.x; outputs[o + 14u] = mx.y;
    }
}
